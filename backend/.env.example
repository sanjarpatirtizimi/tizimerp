# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/driver_loyalty?schema=public"

# --- App ---
PORT=3001
NODE_ENV=development

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Hikvision / Business rules ---
STAMP_AMOUNT_UZS=30000
RECOGNITION_COOLDOWN_MINUTES=0
# Bir odamga barcha Face ID lar bo'yicha qayta pechat (ms). Standart: 3 soat
# RECOGNITION_BURST_GUARD_MS=10800000
DEVICE_CREDENTIALS_ENC_KEY="change-me-32-byte-hex-key-for-aes-256"

# --- Webhook auth (shared secret the device/proxy must send) ---
HIKVISION_WEBHOOK_SECRET="change-me-webhook-secret"
