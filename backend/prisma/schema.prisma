// ============================================================================
// Driver Loyalty, Wallet & Mini-ERP System — Database Schema
// ============================================================================
// Design principles:
// 1. The ledger (Transaction) table is APPEND-ONLY. Balances are NEVER stored
//    as a mutable column — they are always derived by SUM(amount).
// 2. Money is stored as Decimal(14,2) to avoid floating point rounding errors.
// 3. Every foreign key that represents "who/what triggered this" is nullable
//    where appropriate (e.g. a STAMP transaction has no operatorId, a manual
//    CASH_ADVANCE has no deviceId) so a single Transaction model can express
//    every financial event type.
// 4. Hikvision device registration is modeled as its own join table
//    (DriverDeviceRegistration) because a driver may need to be enrolled on
//    several gates/devices, and each enrollment can succeed/fail independently.
// 5. RecognitionEvent stores the raw webhook payload for every inbound
//    Hikvision event (even ignored/duplicate ones) — this is what powers the
//    cooldown/anti-fraud check and gives us a full audit trail.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  OPERATOR
}

enum DriverStatus {
  ACTIVE // can be recognized, receive stamps, request advances
  BLOCKED // frozen — no new transactions allowed
  PENDING // registered in system, not yet synced to any device
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  ERROR
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum TransactionType {
  STAMP // + amount, automatic, from a recognized face event
  CASH_ADVANCE // - amount, manual, issued by an Operator
  GOODS_EXCHANGE // - amount, manual, issued by an Operator (linked to a Product)
  MANUAL_ADJUSTMENT // +/- amount, manual correction by SuperAdmin (requires reason)
  STAMP_REDEMPTION // - amount when pechat(lar) yechiladi (pul / mahsulot / boshqa)
}

enum StampRedeemKind {
  CASH // pulga
  GOODS // mahsulotga
  OTHER // boshqa
}

enum AdKind {
  POPUP // modal, dismissible
  SLIDESHOW // non-blocking top carousel (min 2 images)
}

enum RecognitionEventStatus {
  PROCESSED // resulted in a new STAMP transaction
  IGNORED_COOLDOWN // same driver recognized again within cooldown window
  UNMATCHED // device sent an employeeNo we don't recognize as an active driver
  ERROR // processing failed (bad payload, DB error, etc.)
}

enum FeedbackStatus {
  OPEN
  READ
  RESOLVED
}

/// Operator smena kassasi (operator puli) — append-only ledger.
enum OperatorCashEntryType {
  SHIFT_OPEN // ertalab o'ziga pul o'tkazish (+)
  CASH_OUT_ADVANCE // haydovchiga avans (-)
  CASH_OUT_STAMP // pechatni pulga yechish (-)
  SHIFT_TRANSFER_OUT // smen tugatish — boshqaga (-)
  SHIFT_TRANSFER_IN // smen qabul — boshqadan (+)
}

// ----------------------------------------------------------------------------
// AUTH & ACCESS
// ----------------------------------------------------------------------------

/// Internal staff accounts: SuperAdmins and Operators.
model User {
  id           String   @id @default(cuid())
  fullName     String
  phone        String   @unique
  passwordHash String
  role         UserRole @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Transactions this user issued as an operator (advances, exchanges, adjustments)
  issuedTransactions Transaction[]  @relation("TransactionOperator")
  redeemedStamps     Transaction[]  @relation("StampRedeemedBy")
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]
  flaggedVisits      RecognitionEvent[] @relation("VisitFlaggedBy")
  createdAds         Ad[]               @relation("AdCreatedBy")
  operatorCashEntries       OperatorCashEntry[] @relation("OperatorCashOwner")
  operatorCashCounterparties OperatorCashEntry[] @relation("OperatorCashCounterparty")

  @@index([role])
  @@map("users")
}

/// Truck drivers — the primary "customer" of the loyalty system.
model Driver {
  id           String       @id @default(cuid())
  fullName     String
  phone        String       @unique
  passwordHash String? // optional — drivers can also log in purely via OTP
  carPlate     String? // e.g. "01 A 123 AA"
  carBrand     String?
  carModel     String?
  /// Public URL path for the face photo (e.g. /api/public/driver-photos/:id).
  photoUrl      String?
  /// Durable photo bytes in Postgres — survives Render disk wipes/redeploys.
  photoBytes    Bytes?
  photoMimeType String?       @default("image/jpeg")
  status        DriverStatus  @default(PENDING)
  /// Soft-delete timestamp. Null = active record. Ledger rows are kept.
  deletedAt     DateTime?
  /// Optional Telegram handle (@username) or phone text — no bot required.
  telegramUsername String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  transactions        Transaction[]
  deviceRegistrations DriverDeviceRegistration[]
  recognitionEvents   RecognitionEvent[]
  otpCodes            OtpCode[]
  refreshTokens       RefreshToken[]
  feedback            DriverFeedback[]
  adDismissals        AdDismissal[]

  @@index([status])
  @@index([phone])
  @@index([deletedAt])
  @@map("drivers")
}

/// Short-lived OTP codes for driver phone-number login.
model OtpCode {
  id         String    @id @default(cuid())
  driverId   String
  driver     Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  code       String // hashed in application layer before persisting
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([driverId, expiresAt])
  @@map("otp_codes")
}

/// Refresh tokens for both staff (User) and Driver sessions.
/// Exactly one of userId / driverId is set per row.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  driverId  String?
  driver    Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([driverId])
  @@map("refresh_tokens")
}

// ----------------------------------------------------------------------------
// HIKVISION DEVICES
// ----------------------------------------------------------------------------

/// A physical Hikvision face-recognition gate/terminal. May be created
/// explicitly by an operator (with real ISAPI credentials, for push-based
/// enrollment), OR auto-provisioned the first time it POSTs to our webhook
/// with a device id/slug we've never seen before (no credentials — it's
/// enrolled locally on the device itself, we only ever receive events).
model Device {
  id          String       @id @default(cuid())
  name        String // e.g. "Main Gate", "Warehouse Entrance"
  ipAddress   String? // only set for devices we control via ISAPI directly
  port        Int          @default(80)
  username    String? // ISAPI auth username, if any
  passwordEnc String? // ISAPI auth password, encrypted at rest, if any
  location    String?
  status      DeviceStatus @default(OFFLINE)
  lastPingAt  DateTime?
  /// bcrypt hash of the API key issued to a local "relay agent" — a small
  /// program running on a device on the SAME local network as this
  /// terminal (e.g. a tablet at the gate), which polls our backend for
  /// newly-added drivers and pushes their photo to the terminal itself via
  /// local ISAPI. Lets us auto-enroll faces without this app needing any
  /// direct network path to the terminal (no port-forwarding needed).
  agentKeyHash      String?
  agentKeyCreatedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  registrations     DriverDeviceRegistration[]
  recognitionEvents RecognitionEvent[]
  transactions      Transaction[]

  @@unique([ipAddress, port])
  @@map("devices")
}

/// Enrollment status of a Driver's face on a specific Device.
/// A driver can be (and often needs to be) enrolled on multiple gates.
model DriverDeviceRegistration {
  id              String     @id @default(cuid())
  driverId        String
  driver          Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  deviceId        String
  device          Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  hikvisionFaceId String? // employeeNo/FaceID/FDID returned by the ISAPI call, or claimed via pairing
  syncStatus      SyncStatus @default(PENDING)
  syncError       String?
  syncedAt        DateTime?
  /// Set while this row is "armed" waiting for the driver to touch their
  /// face on `device` for the first time — the next unmatched recognition
  /// event from this device (before this expires) auto-claims this row by
  /// filling in `hikvisionFaceId`. Null once confirmed (or if never armed).
  pairingExpiresAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([driverId, deviceId])
  @@map("driver_device_registrations")
}

/// Raw log of EVERY inbound Hikvision recognition webhook, matched or not,
/// processed or ignored. This is the source of truth for the cooldown check
/// ("has this driver already been stamped in the last hour?") and doubles as
/// a full audit/debug trail for hardware issues.
model RecognitionEvent {
  id            String                 @id @default(cuid())
  deviceId      String
  device        Device                 @relation(fields: [deviceId], references: [id])
  driverId      String?
  driver        Driver?                @relation(fields: [driverId], references: [id])
  employeeNoRaw String? // raw employeeNo/personId from the device payload
  eventDateTime DateTime? // device-reported dateTime (event_log.dateTime), if any
  status        RecognitionEventStatus
  rawPayload    Json // full webhook body, for debugging / replay
  capturedPhotoUrl String? // face snapshot the device attached to this event, if any
  transactionId String?                @unique
  transaction   Transaction?           @relation(fields: [transactionId], references: [id])
  /// Staff red-flag on this specific visit/pechat (not the whole driver).
  isRedFlagged Boolean   @default(false)
  flaggedAt    DateTime?
  flaggedById  String?
  flaggedBy    User?     @relation("VisitFlaggedBy", fields: [flaggedById], references: [id])
  flagNote     String?
  createdAt     DateTime               @default(now())

  @@index([driverId, createdAt])
  @@index([deviceId, createdAt])
  @@index([isRedFlagged, createdAt])
  @@map("recognition_events")
}

/// Driver opinions / complaints visible to Operator and SuperAdmin.
model DriverFeedback {
  id        String         @id @default(cuid())
  driverId  String
  driver    Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  body      String
  status    FeedbackStatus @default(OPEN)
  staffNote String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([driverId, createdAt])
  @@map("driver_feedback")
}

// ----------------------------------------------------------------------------
// MINI-ERP: GOODS CATALOG
// ----------------------------------------------------------------------------

/// Catalog of goods drivers can exchange points for (tires, electronics, etc).
model Product {
  id        String   @id @default(cuid())
  name      String // e.g. "Tire R15", "Power Bank 20000mAh"
  category  String? // e.g. "TIRE", "ELECTRONICS", "OTHER"
  unitPrice Decimal  @db.Decimal(14, 2) // point value of one unit, in UZS
  stockQty  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@map("products")
}

// ----------------------------------------------------------------------------
// IN-APP ADS — SuperAdmin campaigns shown to drivers on app entry
// ----------------------------------------------------------------------------

/// Promo / reklama shown as a dismissible popup when a driver opens the app,
/// or as a non-blocking top slideshow banner.
model Ad {
  id               String   @id @default(cuid())
  kind             AdKind   @default(POPUP)
  title            String
  body             String?
  phone            String?
  telegramUsername String?
  linkUrl          String?
  /// Public path e.g. /api/public/ad-images/:id (POPUP single image).
  imageUrl         String?
  imageBytes       Bytes?
  imageMimeType    String?  @default("image/jpeg")
  startsAt         DateTime
  endsAt           DateTime
  /// Optional 1–100; null = 100% (all drivers). Stable hash(adId+driverId).
  audiencePercent  Int?
  isActive         Boolean  @default(true)
  createdById      String?
  createdBy        User?    @relation("AdCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dismissals AdDismissal[]
  slides     AdSlide[]

  @@index([isActive, startsAt, endsAt])
  @@index([kind, isActive, startsAt, endsAt])
  @@map("ads")
}

/// One frame in a SLIDESHOW ad (image + optional caption overrides).
model AdSlide {
  id            String  @id @default(cuid())
  adId          String
  ad            Ad      @relation(fields: [adId], references: [id], onDelete: Cascade)
  sortOrder     Int     @default(0)
  title         String?
  body          String?
  imageUrl      String?
  imageBytes    Bytes?
  imageMimeType String? @default("image/jpeg")
  createdAt     DateTime @default(now())

  @@index([adId, sortOrder])
  @@map("ad_slides")
}

/// Driver closed an ad with X — do not show that ad again to them.
model AdDismissal {
  id          String   @id @default(cuid())
  adId        String
  ad          Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  dismissedAt DateTime @default(now())

  @@unique([adId, driverId])
  @@index([driverId])
  @@map("ad_dismissals")
}

// ----------------------------------------------------------------------------
// THE LEDGER — single source of truth for every driver's balance
// ----------------------------------------------------------------------------

/// Ledger: amounts are append-only (never change amount/type after insert).
/// Exception: STAMP rows may get redemption metadata (redeemedAt…) for UI —
/// money movement for pechat yechish is a separate STAMP_REDEMPTION insert.
/// Balance = SUM(amount). Lifetime stamps = SUM where type = STAMP.
model Transaction {
  id       String          @id @default(cuid())
  driverId String
  driver   Driver          @relation(fields: [driverId], references: [id])
  type     TransactionType

  // Positive for STAMP / positive MANUAL_ADJUSTMENT.
  // Negative for CASH_ADVANCE / GOODS_EXCHANGE / STAMP_REDEMPTION / negative MANUAL_ADJUSTMENT.
  amount Decimal @db.Decimal(14, 2)

  description String?

  // Who/what caused this transaction (mutually context-dependent, all nullable):
  operatorId String? // set for CASH_ADVANCE, GOODS_EXCHANGE, MANUAL_ADJUSTMENT, STAMP_REDEMPTION
  operator   User?    @relation("TransactionOperator", fields: [operatorId], references: [id])
  deviceId   String? // set for STAMP (which gate triggered it)
  device     Device?  @relation(fields: [deviceId], references: [id])
  productId  String? // set for GOODS_EXCHANGE
  product    Product? @relation(fields: [productId], references: [id])

  /// Set on STAMP rows when pechat yechiladi (visual + audit; amount stays +30000).
  redeemedAt   DateTime?
  redeemedById String?
  redeemedBy   User?           @relation("StampRedeemedBy", fields: [redeemedById], references: [id])
  redeemKind   StampRedeemKind?
  redeemNote   String?

  metadata  Json? // free-form extra data (e.g. { "tireSize": "R15", "qty": 4 })
  createdAt DateTime @default(now())

  recognitionEvent RecognitionEvent?

  @@index([driverId, createdAt])
  @@index([type, createdAt])
  @@index([driverId, type, redeemedAt])
  @@map("transactions")
}

// ----------------------------------------------------------------------------
// OPERATOR CASH FLOAT — smena kassasi (append-only; balance = SUM(amount))
// ----------------------------------------------------------------------------

model OperatorCashEntry {
  id         String                @id @default(cuid())
  operatorId String
  operator   User                  @relation("OperatorCashOwner", fields: [operatorId], references: [id])
  type       OperatorCashEntryType
  /// Signed: + kirim, - chiqim. Balans hech qachon alohida saqlanmaydi.
  amount     Decimal               @db.Decimal(14, 2)
  note       String?

  /// Transferda juft operator (OUT uchun qabul qiluvchi, IN uchun yuboruvchi).
  counterpartyId String?
  counterparty   User?   @relation("OperatorCashCounterparty", fields: [counterpartyId], references: [id])

  /// Avans / pechat yechishda haydovchi ledger qatori.
  driverTransactionId String?

  /// Bir smen transferining juft yozuvlari (OUT + IN) uchun bir xil id.
  transferGroupId String?

  createdAt DateTime @default(now())

  @@index([operatorId, createdAt])
  @@index([transferGroupId])
  @@index([driverTransactionId])
  @@map("operator_cash_entries")
}

// ----------------------------------------------------------------------------
// AUDIT LOG — tracks every meaningful staff action (SuperAdmin requirement)
// ----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String // e.g. "DRIVER_CREATED", "CASH_ADVANCE_ISSUED", "DEVICE_UPDATED"
  entityType String // e.g. "Driver", "Transaction", "Device"
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
