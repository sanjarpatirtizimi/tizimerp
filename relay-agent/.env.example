# Sanjar Patir backend manzili (oxirida /api bilan)
API_BASE_URL=https://driver-loyalty-backend.onrender.com/api

# "Qurilmalar" sahifasidagi qurilma ID'si (Agent kaliti oynasida ko'rsatiladi)
DEVICE_ID=

# "Agent kaliti" oynasida bir marta ko'rsatiladigan kalit
AGENT_KEY=

# Qurilmaning shu tarmoqdagi mahalliy IP-manzili va porti
DEVICE_IP=192.168.1.10
DEVICE_PORT=80

# Qurilmaning ISAPI (admin panel) login va paroli
DEVICE_USERNAME=admin
DEVICE_PASSWORD=

# Serverni necha millisekundda bir tekshirish (standart: 1 soniya)
POLL_INTERVAL_MS=1000

# Face ID dan pechat voqealarini LAN orqali o'qish (tavsiya: true)
# Qurilma → internet webhook o'rniga ishonchli yo'l.
STAMP_POLL_ENABLED=true
